<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid.fan.control">
<!ENTITY author    "SeraphimSerapis">
<!ENTITY version   "2026.10.16">
<!ENTITY sha       "7d3f2ef4645926f9a1c4c9758c1897dd1fc75266">
<!ENTITY repo      "https://raw.githubusercontent.com/SeraphimSerapis/unraid-fan-control/&sha;/src/&name;">
<!ENTITY src       "/boot/config/plugins/&name;">
<!ENTITY dst       "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" launch="Settings/FanControl">

<CHANGES>
###2026.10.16
- HDD-sourced fans idle at their curve minimum when every HDD is spun down. Unraid
  reports no temperature for a sleeping drive, which the daemon treated as a
  failed sensor and answered with its 55% fail-safe duty.
- Fix updates never reaching an installed system: cached payload files on flash
  were reused forever, whatever commit the plg pinned. The cache is now keyed to
  the pinned commit. Downloads land in a temporary file first, so a failed fetch
  no longer leaves a truncated file behind.
###2026.08.24
- Fix install failure: plg previously assumed payload files were already present in
  /boot/config/plugins/unraid.fan.control/ - with nothing there every cp failed and
  'rc.fancontrol restart' exited non-zero, so emhttp quarantined the plugin to
  plugins-error. The installer now fetches the payload from GitHub (pinned to a
  commit) and caches it on the flash drive.
###2026.08.15
- Initial release.
- Per-fan curves with independent temperature sources.
- Per-fan stall floor and emergency trip.
- Silent / Balanced / Cool presets per temperature source.
- fan-detect helper for mapping channels and measuring stall floors.
</CHANGES>

<FILE Run="/bin/bash" Method="install">
<INLINE>
# ---- fetch payload from GitHub (pinned commit), cache on flash ----
# NOTE: no CDATA here - emhttp does not expand entities inside CDATA blocks,
# so all ampersands must be written as &amp; (see appdata.backup.plg for precedent).
fetch() {
  local rel="$1" out="&src;/$1"
  [ -s "$out" ] &amp;&amp; [ "$cached" = "&sha;" ] &amp;&amp; return 0   # cached for this commit
  mkdir -p "$(dirname "$out")"
  if ! curl -fsSL --max-time 60 --retry 2 "&repo;/$rel" -o "$out.part"; then
    rm -f "$out.part"
    echo "ERROR: failed to download $rel"
    return 1
  fi
  mv -f "$out.part" "$out"
}

mkdir -p &src; &dst;/scripts &dst;/include
cached=$(cat &src;/.payload-sha 2>/dev/null)

# The shipped default config has the same name as the live user config, so it is
# only fetched to seed a fresh install. An update must never overwrite settings.
[ -f &src;/&name;.cfg ] || fetch &name;.cfg || exit 1

fetch FanControl.page                 || exit 1
fetch scripts/fancontrol              || exit 1
fetch scripts/rc.fancontrol           || exit 1
fetch scripts/fan-detect              || exit 1
fetch include/status.php              || exit 1
fetch include/update.fancontrol.php   || exit 1
fetch include/presets.php             || exit 1
echo "&sha;" > &src;/.payload-sha

# ---- stage into emhttp ----
mkdir -p &dst;/scripts &dst;/include
cp -f &src;/FanControl.page &dst;/
cp -f &src;/scripts/fancontrol    &dst;/scripts/
cp -f &src;/scripts/rc.fancontrol &dst;/scripts/
cp -f &src;/scripts/fan-detect    &dst;/scripts/
cp -f &src;/include/status.php            &dst;/include/
cp -f &src;/include/update.fancontrol.php &dst;/include/
cp -f &src;/include/presets.php           &dst;/include/
chmod +x &dst;/scripts/fancontrol &dst;/scripts/rc.fancontrol &dst;/scripts/fan-detect

ln -sf &dst;/scripts/fan-detect /usr/local/bin/fan-detect 2>/dev/null

if ! ls /sys/class/hwmon/hwmon*/pwm[0-9] >/dev/null 2&gt;&amp;1; then
  echo ""
  echo "WARNING: no writable pwm nodes found."
  echo "This plugin needs a super-I/O driver for your board:"
  echo "  ITE chips     -> install the 'it87-driver' plugin"
  echo "  Nuvoton chips -> modprobe nct6775"
  echo "Run 'fan-detect' after loading one."
  echo ""
fi

&dst;/scripts/rc.fancontrol restart
echo "&name; &version; installed"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
&dst;/scripts/rc.fancontrol stop 2>/dev/null

# Hand every channel back to the chip so fans are never left under our control.
for h in /sys/class/hwmon/hwmon*; do
  for p in $h/pwm[0-9]_enable; do [ -w "$p" ] &amp;&amp; echo 2 > "$p"; done
done

rm -f /usr/local/bin/fan-detect
rm -rf &dst;
echo "&name; removed - fans returned to chip automatic mode"
</INLINE>
</FILE>

</PLUGIN>
